# Copy to .env for local development, and set the same value as a
# Cloudflare secret for production:  npx wrangler secret put DATABASE_URL
#
# Local sandbox example:
#   DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db
#
# Production (Neon / Supabase / any managed Postgres). Must be reachable
# over the public internet and use SSL:
#   DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db
